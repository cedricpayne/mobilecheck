{
  "name": "telegram-avatar-video-bot",
  "version": "1.0.0",
  "description": "Telegram bot that generates AI avatar videos from reference images with custom voice scripts",
  "main": "dist/src/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/server.js",
    "dev": "ts-node src/server.ts",
    "dev:watch": "nodemon --exec ts-node src/server.ts"
  },
  "dependencies": {
    "node-telegram-bot-api": "^0.66.0",
    "express": "^4.18.2",
    "bullmq": "^5.1.0",
    "ioredis": "^5.3.2",
    "axios": "^1.6.5",
    "uuid": "^9.0.0",
    "dotenv": "^16.3.1",
    "fluent-ffmpeg": "^2.1.2",
    "winston": "^3.11.0",
    "replicate": "^0.25.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/express": "^4.17.21",
    "@types/node-telegram-bot-api": "^0.64.2",
    "@types/fluent-ffmpeg": "^2.1.24",
    "@types/uuid": "^9.0.7",
    "typescript": "^5.3.3",
    "ts-node": "^10.9.2",
    "nodemon": "^3.0.2"
  }
}
