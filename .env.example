# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Server (Railway sets PORT automatically)
PORT=3000

# Webhook — auto-detected on Railway via RAILWAY_PUBLIC_DOMAIN
# Set manually only if needed:
# USE_WEBHOOK=true
# BASE_URL=https://your-domain.com

# ElevenLabs
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Replicate (for SadTalker lip-sync)
REPLICATE_API_TOKEN=your_replicate_api_token_here

# D-ID (alternative lip-sync provider)
# DID_API_KEY=your_did_api_key_here

# Lip-sync provider: "replicate" | "did"
LIPSYNC_PROVIDER=replicate

# Redis — Railway provides REDIS_URL automatically when you add Redis
# REDIS_URL=redis://default:password@host:port
# Or set individually:
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Storage (Railway uses ephemeral /tmp)
STORAGE_DIR=/tmp/avatar-bot-storage

# Limits
MAX_SCRIPT_LENGTH=2000
MAX_CONCURRENT_JOBS=3
JOB_TIMEOUT_MS=300000
